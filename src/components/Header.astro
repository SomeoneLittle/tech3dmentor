---
import { t, path, type Lang } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  /** Путь текущей страницы без языка — нужен переключателю языка и подсветке пункта меню */
  page?: string;
}

const { lang, page = '' } = Astro.props;
const dict = t(lang);

const links = [
  { key: 'portfolio', label: dict.nav.portfolio },
  { key: 'mentoring', label: dict.nav.mentoring },
  { key: 'marketplace', label: dict.nav.marketplace },
  { key: 'blog', label: dict.nav.blog },
  { key: 'about', label: dict.nav.about },
  { key: 'contacts', label: dict.nav.contacts },
];
const isActive = (key: string) => page === key || page.startsWith(`${key}/`);
const bookHref = `${path(lang, 'mentoring')}#apply`;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.4)]">
  <div class="h-14 lg:h-20 max-w-[1440px] mx-auto px-4 md:px-margin-desktop flex items-center justify-between gap-space-md">
    <a href={path(lang)} class="flex items-center gap-space-sm shrink-0" aria-label={dict.site.name}>
      <svg class="h-6 w-6 lg:h-8 lg:w-8 text-primary" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 3 28 9.5v13L16 29 4 22.5v-13z" />
        <path d="M4 9.5 16 16l12-6.5M16 16v13" />
      </svg>
      <span class="flex flex-col">
        <span class="font-headline-sm text-sm lg:text-headline-sm leading-none text-on-surface tracking-tight uppercase">{dict.site.name}</span>
        <span class="font-tech-data-sm text-[9px] lg:text-tech-data-sm text-primary tracking-widest uppercase mt-0.5">{dict.site.role}</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-space-lg" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={path(lang, link.key)}
            aria-current={isActive(link.key) ? 'page' : undefined}
            class:list={[
              'font-tech-data-lg text-tech-data-lg tracking-wide uppercase transition-colors',
              isActive(link.key) ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 lg:gap-space-md shrink-0">
      <div class="hidden lg:block"><LangSwitcher lang={lang} page={page} /></div>
      <button
        type="button"
        data-open-favorites
        aria-label={dict.header.favorites}
        class="relative w-11 h-11 lg:w-auto lg:h-auto lg:p-2 rounded-full lg:bg-surface-container-low text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors flex items-center justify-center"
      >
        <span class="material-symbols-outlined text-[20px]">favorite</span>
        <span data-favorites-count class="hidden absolute -top-1 -right-1 bg-tertiary-container text-on-tertiary font-tech-data-sm text-[9px] px-1.5 rounded-full font-bold shadow-sm">0</span>
      </button>
      <button
        type="button"
        data-open-auth
        aria-label={dict.header.account}
        class="relative w-11 h-11 lg:w-9 lg:h-9 flex items-center justify-center lg:rounded-full lg:bg-primary flex items-center justify-center hover:bg-primary-container transition-colors"
      >
        <span class="w-7 h-7 lg:w-auto lg:h-auto rounded-full bg-primary lg:bg-transparent flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[16px] lg:text-[18px]">person</span></span>
        <span data-auth-dot class="hidden absolute top-0 right-0 w-2.5 h-2.5 rounded-full bg-secondary-container ring-2 ring-surface shadow-[0_0_8px_rgba(52,255,140,0.6)]"></span>
      </button>
      <a
        href={bookHref}
        class="hidden xl:inline-flex items-center justify-center px-space-md py-2 rounded-full bg-gradient-to-r from-primary-container to-tertiary-container text-on-surface font-headline-sm text-tech-data-lg uppercase tracking-wider shadow-[0_0_20px_-4px_rgba(160,120,255,0.45)] hover:shadow-[0_0_28px_rgba(255,87,34,0.55)] transition-all active:scale-95"
      >
        {dict.header.book}
      </a>
      <button
        type="button"
        id="burger"
        aria-label={dict.header.menu}
        aria-expanded="false"
        aria-controls="nav-drawer"
        class="lg:hidden w-11 h-11 rounded-lg text-on-surface hover:text-primary active:bg-surface-container flex items-center justify-center"
      >
        <span class="material-symbols-outlined text-[22px]">menu</span>
      </button>
    </div>
  </div>

</header>

<div id="nav-drawer" class="lg:hidden fixed inset-0 z-[60] bg-black/75 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none">
  <div id="nav-drawer-panel" class="absolute top-0 right-0 bottom-0 w-[85%] max-w-[320px] bg-surface-container-lowest border-l border-surface-container-highest flex flex-col p-5 justify-between translate-x-full transition-transform duration-300">
    <div class="flex items-center justify-between pb-4 border-b border-surface-container-highest">
      <span class="font-headline-sm text-sm font-bold text-on-surface uppercase tracking-tight">{dict.header.menu}</span>
      <button type="button" id="menu-close-btn" aria-label={dict.header.menu} class="w-10 h-10 flex items-center justify-center rounded-full text-on-surface hover:text-primary active:bg-surface-container">
        <span class="material-symbols-outlined text-[22px]">close</span>
      </button>
    </div>
    <nav class="flex flex-col gap-1 py-4 flex-1 overflow-y-auto" aria-label="Mobile">
      {
        links.map((link, i) => (
          <a
            href={path(lang, link.key)}
            class="drawer-link flex items-center justify-between p-3 rounded-xl hover:bg-surface-container font-tech-data-lg text-sm tracking-wide uppercase transition-colors"
          >
            <span class="flex items-center gap-2.5">
              <span class:list={['font-tech-data-sm text-xs', isActive(link.key) ? 'text-primary' : 'text-outline']}>{String(i + 1).padStart(2, '0')}.</span>
              <span class={isActive(link.key) ? 'text-primary' : 'text-on-surface'}>{link.label}</span>
            </span>
            <span class="material-symbols-outlined text-outline text-[16px]">chevron_right</span>
          </a>
        ))
      }
    </nav>
    <div class="pt-4 border-t border-surface-container-highest flex flex-col gap-3">
      <div class="flex justify-center"><LangSwitcher lang={lang} page={page} /></div>
      <a
        href={bookHref}
        class="drawer-link min-h-[46px] w-full py-3 rounded-full bg-gradient-to-r from-primary-container to-tertiary-container text-on-surface font-headline-sm text-xs font-bold uppercase tracking-wider shadow-lg flex items-center justify-center gap-2"
      >
        <span>{dict.header.book}</span>
        <span class="material-symbols-outlined text-[16px]">calendar_month</span>
      </a>
    </div>
  </div>
</div>

<script>
  const burger = document.getElementById('burger');
  const drawer = document.getElementById('nav-drawer');
  const panel = document.getElementById('nav-drawer-panel');
  const setDrawer = (open: boolean) => {
    drawer?.classList.toggle('opacity-0', !open);
    drawer?.classList.toggle('pointer-events-none', !open);
    panel?.classList.toggle('translate-x-full', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    burger?.setAttribute('aria-expanded', String(open));
  };
  burger?.addEventListener('click', () => setDrawer(true));
  document.getElementById('menu-close-btn')?.addEventListener('click', () => setDrawer(false));
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) setDrawer(false);
  });
  document.querySelectorAll('.drawer-link').forEach((l) => l.addEventListener('click', () => setDrawer(false)));
</script>