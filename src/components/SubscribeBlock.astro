---
import { tk, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** page — большой блок внизу списка, item — компактный на странице модели */
  variant?: 'page' | 'item';
}

const { lang, variant = 'page' } = Astro.props;
const d = tk(lang).subscribe;
const inputClass = 'w-full bg-transparent text-on-surface placeholder:text-outline font-tech-data-sm text-tech-data-sm py-2 focus:outline-none';
---

{
  variant === 'page' ? (
    <section class="relative overflow-hidden rounded-2xl bg-surface-container-high p-space-lg md:p-space-xl shadow-2xl">
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-primary-container/20 rounded-full blur-3xl pointer-events-none" />
      <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-tertiary-container/15 rounded-full blur-3xl pointer-events-none" />
      <div class="relative z-10 max-w-3xl flex flex-col gap-space-md">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-secondary-container animate-pulse" />
          <span class="font-tech-data-sm text-tech-data-sm text-secondary-container uppercase tracking-widest font-bold">{d.page.badge}</span>
        </div>
        <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg tracking-tight uppercase text-on-surface">
          {d.page.titleBefore}
          <span class="bg-gradient-to-r from-primary-container via-primary to-tertiary-container bg-clip-text text-transparent">{d.page.titleAccent}</span>
        </h2>
        <p class="font-body-lg text-body-lg text-on-surface-variant">{d.page.text}</p>
        <form data-subscribe class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm pt-2">
          <div class="flex items-center bg-surface-container-lowest rounded-full px-space-md py-1.5 flex-1 shadow-inner focus-within:ring-2 focus-within:ring-primary-container">
            <span class="material-symbols-outlined text-outline text-xl mr-2">mark_email_read</span>
            <input type="email" required placeholder={d.placeholder} aria-label={d.placeholder} class={inputClass} />
          </div>
          <button type="submit" class="px-space-xl py-3.5 rounded-full bg-gradient-to-r from-primary-container to-tertiary-container text-on-surface font-headline-sm text-tech-data-lg uppercase tracking-wider shadow-lg hover:shadow-2xl transition-all transform active:scale-95 shrink-0 text-center">
            {d.page.button}
          </button>
        </form>
        <p data-subscribe-thanks class="hidden flex items-center gap-1.5 text-secondary-container font-tech-data-sm text-tech-data-sm">
          <span class="material-symbols-outlined text-[14px]">check_circle</span>
          {d.thanks}
        </p>
        <div class="flex items-center gap-3 pt-1">
          <span class="material-symbols-outlined text-secondary-container text-sm">verified_user</span>
          <span class="font-tech-data-sm text-tech-data-sm text-outline">{d.small}</span>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative rounded-2xl bg-surface-container overflow-hidden p-space-lg md:p-space-xl shadow-2xl">
      <div class="absolute -right-24 -bottom-24 w-96 h-96 bg-primary-container/20 rounded-full blur-3xl pointer-events-none" />
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
        <div class="lg:col-span-7 flex flex-col gap-space-xs">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-highest text-secondary-fixed font-tech-data-sm text-tech-data-sm w-fit">
            <span class="w-2 h-2 rounded-full bg-secondary-fixed animate-pulse" />
            <span>{d.item.badge}</span>
          </div>
          <h3 class="font-headline-md md:font-headline-lg text-headline-md md:text-headline-lg uppercase text-on-surface tracking-tight leading-none mt-2">{d.item.title}</h3>
          <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">{d.item.text}</p>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-2">
          <form data-subscribe class="flex flex-col sm:flex-row gap-2">
            <input type="email" required placeholder={d.placeholder} aria-label={d.placeholder} class="w-full px-4 py-3 rounded-full bg-surface-container-lowest text-on-surface placeholder:text-outline font-tech-data-sm text-tech-data-sm focus:outline-none focus:ring-2 focus:ring-primary shadow-inner" />
            <button type="submit" class="shrink-0 px-6 py-3 rounded-full bg-gradient-to-r from-primary-container to-tertiary-container text-on-surface font-headline-sm text-tech-data-lg uppercase tracking-wide shadow-lg transition-all active:scale-95">
              {d.item.button}
            </button>
          </form>
          <p data-subscribe-thanks class="hidden flex items-center gap-1.5 text-secondary-fixed font-tech-data-sm text-tech-data-sm">
            <span class="material-symbols-outlined text-[14px]">check_circle</span>
            {d.thanks}
          </p>
          <span class="font-tech-data-sm text-[10px] text-outline">{d.small}</span>
        </div>
      </div>
    </section>
  )
}

<script>
  // Пока без сервиса рассылки: форма только показывает подтверждение. Подключить Mailchimp / Buttondown и т.п. и отправлять email туда.
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) =>
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('!hidden');
      const thanks = form.parentElement?.querySelector<HTMLElement>('[data-subscribe-thanks]');
      thanks?.classList.remove('hidden');
    }),
  );
</script>
