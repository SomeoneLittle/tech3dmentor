---
import { pick, t, path, type Lang } from '../i18n';
import type { PortfolioWork, StatTone, PortfolioCategory } from '../data/portfolio';

interface Props {
  work: PortfolioWork;
  lang: Lang;
  /** Позиция в списке (для сортировки «новые») */
  index: number;
}

const { work, lang, index } = Astro.props;
const dict = t(lang);
const href = path(lang, `portfolio/${work.slug}`);
const title = pick(work.title, lang);

const categoryTone: Record<PortfolioCategory, string> = {
  characters: 'text-secondary-container',
  hardSurface: 'text-tertiary',
  sculpting: 'text-primary',
  environment: 'text-outline',
};
const statTone: Record<StatTone, string> = {
  default: 'text-on-surface',
  primary: 'text-primary',
  green: 'text-secondary-container',
  peach: 'text-tertiary',
  orange: 'text-tertiary-container',
};
---

<article
  data-work-card
  data-category={work.category}
  data-index={index}
  data-featured={work.featured ? '1' : '0'}
  data-poly={work.polys}
  class="group relative bg-surface-container-low rounded-xl overflow-hidden shadow-lg transition-transform duration-300 will-change-transform hover:-translate-y-1 flex flex-col"
>
  <div class="hidden md:flex bg-surface-container-highest/80 backdrop-blur-md px-3 py-2 items-center justify-between text-outline">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
      <span class="font-tech-data-sm text-tech-data-sm text-on-surface font-mono">{work.cam}</span>
    </div>
    <span class="font-label-caps text-label-caps text-secondary-container">{work.camBadge}</span>
  </div>

  <a href={href} tabindex="-1" aria-hidden="true" class="relative block max-md:aspect-square max-md:[[data-view=list]_&]:aspect-video md:h-[320px] md:[[data-view=list]_&]:h-[220px] w-full overflow-hidden bg-surface-container-lowest">
    <img
      src={work.image}
      alt=""
      loading={index < 3 ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    {
      work.video && (
        <video
          src={work.video}
          poster={work.image}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      )
    }
    {
      work.matcap && (
        <div class="hidden md:flex absolute top-3 right-3 flex items-center gap-1.5 bg-surface-container-highest/90 backdrop-blur-md px-2 py-1 rounded-full shadow-sm">
          <div class:list={['w-4 h-4 rounded-full shadow-inner', work.matcap.swatch]}></div>
          <span class="font-label-caps text-label-caps text-on-surface uppercase">{work.matcap.label}</span>
        </div>
      )
    }
    <div class="md:hidden absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded bg-surface-container-lowest/80 backdrop-blur text-[9px] text-secondary-container font-mono">{work.cam}</div>
    <button
      type="button"
      data-favorite-toggle
      aria-pressed="false"
      aria-label={dict.portfolio.favorite}
      class="md:hidden absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-surface-container-lowest/80 flex items-center justify-center text-on-surface-variant aria-pressed:text-tertiary-container"
    >
      <span class="material-symbols-outlined text-[14px]">favorite</span>
    </button>
    <div class="absolute bottom-1.5 left-1.5 right-1.5 md:bottom-3 md:left-3 md:right-auto flex flex-wrap gap-1.5 max-md:justify-between max-md:flex-nowrap">
      {
        work.stats.map((stat, i) => (
          <span class:list={['font-tech-data-sm text-[9px] md:text-tech-data-sm bg-surface-container-lowest/90 px-1.5 md:px-2 py-0.5 rounded backdrop-blur-sm', statTone[stat.tone], i > 1 && 'max-md:hidden']}>
            {stat.text}
          </span>
        ))
      }
    </div>
  </a>

  <div class="p-2.5 md:p-5 flex flex-col gap-1 md:gap-3 bg-surface-container-low flex-1">
    <div class="flex items-start justify-between gap-2 min-w-0">
      <div class="min-w-0">
        <span class:list={['font-label-caps text-label-caps uppercase block truncate', categoryTone[work.category]]}>
          {dict.portfolio.filters[work.category]} // {pick(work.sub, lang)}
        </span>
        <h2 class="font-headline-sm text-[15px] md:text-headline-sm font-bold md:font-semibold text-on-surface mt-0.5 truncate md:whitespace-normal">
          <a href={href} class="hover:text-primary transition-colors">{title}</a>
        </h2>
      </div>
      <button
        type="button"
        data-favorite-toggle
        aria-pressed="false"
        aria-label={dict.portfolio.favorite}
        class="hidden md:block p-2 rounded-full bg-surface-container hover:bg-surface-container-high text-outline hover:text-tertiary transition-colors aria-pressed:text-tertiary-container"
      >
        <span class="material-symbols-outlined text-[18px]">favorite</span>
      </button>
    </div>
    <p class="hidden md:block font-body-sm text-body-sm text-on-surface-variant line-clamp-2">{pick(work.desc, lang)}</p>
    <div class="flex items-center justify-between gap-2 pt-1 md:pt-2 mt-auto md:flex-wrap">
      <div class="flex flex-wrap items-center gap-1.5">
        {work.tools.map((tool, i) => <span class:list={['font-tech-data-sm text-[10px] md:text-tech-data-sm md:bg-surface-container md:px-2 md:py-0.5 rounded text-secondary-container md:text-outline', i > 0 && 'max-md:hidden']}>{tool}</span>)}
      </div>
      <a href={href} class="flex items-center gap-0.5 md:gap-1 font-tech-data-sm text-[10px] md:text-tech-data-sm text-primary hover:text-on-surface transition-colors">
        {dict.portfolio.inspect} <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
      </a>
    </div>
  </div>
</article>
