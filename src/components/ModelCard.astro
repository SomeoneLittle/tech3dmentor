---
import { pick, t, path, type Lang } from '../i18n';
import type { Model } from '../data/home';

interface Props {
  model: Model;
  lang: Lang;
}

const { model, lang } = Astro.props;
const dict = t(lang);
---

<div class="relative bg-surface-container rounded-xl overflow-hidden shadow-xl flex flex-col group hover:-translate-y-1 transition-transform duration-300 will-change-transform">
  <a href={path(lang, `marketplace/${model.slug}`)} class="flex flex-col flex-1">
    <div class="relative h-32 md:h-56 bg-surface-container-lowest overflow-hidden">
      <img
        src={model.image}
        alt={pick(model.title, lang)}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute bottom-1.5 left-1.5 md:bottom-2 md:left-2 px-1.5 md:px-2 py-0.5 rounded bg-surface-container-lowest/85 font-tech-data-sm text-[8px] md:text-tech-data-sm text-secondary-container font-semibold">
        {pick(model.badge, lang)}
      </div>
    </div>
    <div class="p-2 md:p-space-md flex flex-col gap-1.5 md:gap-space-xs flex-1 justify-between">
      <div>
        <div class="flex flex-wrap gap-1 mb-1 md:mb-2">
          {model.formats.map((f) => <span class="px-1.5 py-0.5 rounded bg-surface-container-high font-tech-data-sm text-[8px] md:text-[10px] text-outline md:text-on-surface-variant">{f}</span>)}
        </div>
        <h3 class="font-headline-sm text-xs md:text-tech-data-lg font-bold text-on-surface uppercase tracking-tight line-clamp-1">{pick(model.title, lang)}</h3>
        <p class="hidden md:block font-body-sm text-body-sm text-on-surface-variant mt-1">{pick(model.desc, lang)}</p>
      </div>
      <div class="pt-1 md:pt-space-sm max-md:border-t max-md:border-surface-container-highest/60 flex items-center justify-between font-tech-data-sm text-tech-data-sm">
        <span class="text-on-surface font-bold text-[10px] md:text-tech-data-lg">{model.price ? `$${model.price}` : '$--'}</span>
        <span class="text-outline uppercase text-[9px] md:text-[11px]">{dict.marketplace.on}</span>
      </div>
    </div>
  </a>
  <button
    type="button"
    data-favorite={model.slug}
    aria-label={dict.marketplace.favorite}
    class="absolute top-1.5 right-1.5 md:top-3 md:right-3 w-7 h-7 md:w-8 md:h-8 rounded-full bg-surface-container-lowest/80 backdrop-blur-md flex items-center justify-center text-on-surface hover:text-tertiary transition-colors shadow"
  >
    <span class="material-symbols-outlined text-[14px] md:text-[18px]">favorite</span>
  </button>
</div>
