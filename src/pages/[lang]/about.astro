---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, t, ta, path, type Lang } from '../../i18n';
import { SITE } from '../../config';
import { mockImages } from '../../data/mockImages';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
const a = ta(lang);

const wrap = 'max-w-[1440px] mx-auto px-4 md:px-margin-desktop';
const kicker = 'font-tech-data-sm text-tech-data-sm tracking-widest uppercase';
const h2 = 'font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight uppercase';
const gradientBtn =
  'rounded-full bg-gradient-to-r from-primary-container to-tertiary-container text-on-surface font-headline-sm text-xs md:text-tech-data-lg uppercase tracking-wider shadow-[0_0_24px_-4px_rgba(160,120,255,0.45)] hover:shadow-[0_0_32px_rgba(255,87,34,0.6)] transition-all transform active:scale-95';

// Иконки и цвета не переводятся, лежат рядом с текстами из словаря по индексу.
const statTone = ['text-secondary-container', 'text-primary', 'text-tertiary'];
const pillarVisuals = [
  { icon: 'polyline', icon_cls: 'text-primary', dot: 'bg-secondary-container', text: 'text-secondary-container' },
  { icon: 'brush', icon_cls: 'text-tertiary', dot: 'bg-tertiary-container', text: 'text-tertiary' },
  { icon: 'co_present', icon_cls: 'text-secondary-container', dot: 'bg-primary-container', text: 'text-primary' },
];
const toolVisuals = [
  { icon: 'draw', cls: 'text-primary' },
  { icon: 'view_in_ar', cls: 'text-tertiary' },
  { icon: 'light_mode', cls: 'text-secondary-container' },
  { icon: 'sports_esports', cls: 'text-primary-fixed' },
  { icon: 'palette', cls: 'text-tertiary-fixed' },
  { icon: 'checkroom', cls: 'text-primary' },
  { icon: 'grid_4x4', cls: 'text-secondary-container' },
  { icon: 'memory', cls: 'text-outline' },
];
const expTone = ['text-secondary-container', 'text-primary', 'text-tertiary', 'text-outline'];
const workVisuals = [
  { image: mockImages.work2, text: 'text-primary', dot: 'bg-secondary-container animate-pulse', swatch: 'bg-gradient-to-br from-primary via-tertiary to-secondary-container' },
  { image: mockImages.work6, text: 'text-tertiary', dot: 'bg-tertiary-container', swatch: 'bg-tertiary' },
  { image: mockImages.work4, text: 'text-secondary-container', dot: 'bg-secondary-container', swatch: 'bg-secondary-fixed' },
];
---

<BaseLayout lang={lang} page="about" title={`${a.seo.title} — ${dict.site.name}`} description={a.seo.description} image={mockImages.aboutPortrait}>
  <!-- HUD / хлебные крошки -->
  <section class="w-full bg-surface-container-lowest">
    <div class={`${wrap} py-space-sm flex flex-wrap items-center justify-between gap-space-xs text-on-surface-variant font-tech-data-sm text-tech-data-sm`}>
      <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs flex-wrap uppercase">
        <a href={path(lang)} class="text-primary hover:underline">{a.crumbs.home}</a>
        <span class="text-outline">/</span>
        <span class="text-primary">{a.crumbs.dossier}</span>
        <span class="text-outline">/</span>
        <span class="text-on-surface font-semibold tracking-wide" aria-current="page">{a.crumbs.about}</span>
        <span class="hidden sm:inline-block ml-2 px-2 py-0.5 rounded-full bg-surface-container text-secondary-container normal-case">{a.hud.spec}</span>
      </nav>
      <div class="flex items-center gap-space-sm text-outline">
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
          {a.hud.fps}
        </span>
        <span class="hidden md:inline">|</span>
        <span class="hidden md:inline">{a.hud.ocio}</span>
      </div>
    </div>
  </section>

  <!-- HERO -->
  <section class="w-full relative overflow-hidden py-4 md:py-space-xl lg:py-space-2xl bg-surface">
    <div class="absolute inset-0 pointer-events-none opacity-40 bg-[radial-gradient(#a078ff_1px,transparent_1px)] [background-size:32px_32px]" aria-hidden="true"></div>
    <div class={`${wrap} relative z-10`}>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg lg:gap-gutter-desktop items-center">
        <div class="lg:col-span-5 relative group">
          <div class="relative rounded-xl overflow-hidden bg-surface-container-low shadow-2xl">
            <div class="flex items-center justify-between px-space-md py-space-xs bg-surface-container-highest/90 backdrop-blur-md">
              <div class="flex items-center gap-space-xs">
                <span class="w-2 h-2 rounded-full bg-tertiary-container"></span>
                <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
                <span class="w-2 h-2 rounded-full bg-primary-container"></span>
                <span class="font-tech-data-sm text-tech-data-sm text-on-surface ml-2">{a.hero.camera}</span>
              </div>
              <span class="hidden sm:inline font-tech-data-sm text-tech-data-sm text-secondary-fixed-dim bg-surface-container-lowest px-2 py-0.5 rounded">{a.hero.focal}</span>
            </div>
            <div class="relative w-full h-[460px] sm:h-[520px]">
              <img
                src={mockImages.aboutPortrait}
                alt={dict.site.name}
                fetchpriority="high"
                decoding="async"
                class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent opacity-85"></div>
              <div class="absolute top-4 left-4 font-tech-data-sm text-tech-data-sm text-secondary-container bg-surface-container-lowest/80 backdrop-blur px-2 py-1 rounded">{a.hero.id}</div>
              <div class="absolute top-4 right-4 flex items-center gap-1.5 bg-surface-container-lowest/80 backdrop-blur px-2.5 py-1 rounded-full">
                <span class="w-4 h-4 rounded-full bg-gradient-to-br from-tertiary via-primary-container to-secondary-container shadow-inner"></span>
                <span class="font-tech-data-sm text-tech-data-sm text-on-surface">{a.hero.shader}</span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-on-surface-variant font-tech-data-sm text-tech-data-sm bg-surface-container-low/90 backdrop-blur px-space-md py-space-xs rounded-lg">
                <div class="flex items-center gap-2">
                  <span class="text-tertiary font-bold">X: +0.024</span>
                  <span class="text-primary font-bold">Y: -1.820</span>
                  <span class="text-secondary-fixed font-bold">Z: +0.941</span>
                </div>
                <span class="hidden sm:inline text-on-surface font-semibold">{a.hero.rot}</span>
              </div>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 hidden sm:flex flex-col bg-surface-container-high px-space-md py-space-xs rounded-lg shadow-xl">
            <span class="font-label-caps text-label-caps text-primary tracking-widest uppercase">{a.hero.clearance}</span>
            <span class="font-tech-data-lg text-xs md:text-tech-data-lg text-on-surface font-bold">{a.hero.clearanceValue}</span>
          </div>
        </div>

        <div class="lg:col-span-7 flex flex-col gap-space-md">
          <div class="flex items-center gap-space-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-tertiary-container animate-pulse"></span>
            <span class={`${kicker} text-tertiary`}>{a.hero.kicker}</span>
          </div>
          <h1 class="font-display-hero-mobile md:font-display-hero text-display-hero-mobile md:text-display-hero text-on-surface tracking-tight uppercase leading-none">
            {a.hero.titleBefore}
            <span class="bg-gradient-to-r from-primary-container via-tertiary to-secondary-container bg-clip-text text-transparent">{a.hero.titleAccent}</span>
          </h1>
          <p class="font-headline-sm text-base md:text-headline-sm text-primary tracking-tight font-medium">{a.hero.role}</p>
          <p class="font-body-lg text-sm md:text-body-lg text-on-surface-variant max-w-2xl">{a.hero.p1}</p>
          <p class="font-body-md text-[13px] leading-5 md:text-body-md text-outline max-w-2xl">{a.hero.p2}</p>
          <div class="grid grid-cols-3 gap-space-sm py-space-sm max-w-xl">
            {
              a.hero.stats.map((stat, i) => (
                <div class="p-space-sm bg-surface-container rounded-lg">
                  <span class:list={['font-tech-data-lg text-xs md:text-tech-data-lg font-bold block', statTone[i]]}>{stat.value}</span>
                  <span class="font-label-caps text-label-caps text-outline uppercase tracking-wider">{stat.label}</span>
                </div>
              ))
            }
          </div>
          <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
            <a href={SITE.artstation} target="_blank" rel="noopener noreferrer" class={`px-space-lg py-space-sm flex items-center gap-2 ${gradientBtn}`}>
              <span>ArtStation</span>
              <span class="material-symbols-outlined text-[18px]">north_east</span>
            </a>
            <a
              href={SITE.cults}
              target="_blank"
              rel="noopener noreferrer"
              class="px-space-lg py-space-sm rounded-full bg-surface-container-high text-on-surface hover:text-secondary-container hover:bg-surface-container-highest transition-all flex items-center gap-2 font-tech-data-lg text-xs md:text-tech-data-lg uppercase tracking-wide"
            >
              <span>{a.hero.cults}</span>
              <span class="material-symbols-outlined text-[18px]">north_east</span>
            </a>
            <a
              href="#resume"
              class="px-space-lg py-space-sm rounded-full bg-surface-container-low text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-all flex items-center gap-2 font-tech-data-lg text-xs md:text-tech-data-lg uppercase tracking-wide"
            >
              <span class="material-symbols-outlined text-[18px]">description</span>
              <span>{a.hero.resume}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- КАК Я РАБОТАЮ -->
  <section class="w-full py-6 md:py-space-2xl bg-surface-container-lowest relative">
    <div class={wrap}>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm mb-4 md:mb-space-xl">
        <div class="flex flex-col gap-space-xs">
          <span class={`${kicker} text-primary`}>{a.pillars.kicker}</span>
          <h2 class={h2}>{a.pillars.title}</h2>
        </div>
        <p class="font-body-md text-[13px] leading-5 md:text-body-md text-on-surface-variant max-w-md">{a.pillars.sub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
        {
          a.pillars.items.map((item, i) => (
            <div class="flex flex-col justify-between p-4 md:p-space-lg bg-surface-container-low rounded-xl hover:bg-surface-container transition-all duration-300 shadow-md">
              <div class="flex flex-col gap-space-md">
                <div class="flex items-center justify-between">
                  <span class="font-display-hero text-headline-lg text-outline-variant font-bold">{`0${i + 1}`}</span>
                  <span class="p-2 rounded-lg bg-surface-container-high flex items-center justify-center">
                    <span class:list={['material-symbols-outlined text-[24px]', pillarVisuals[i].icon_cls]}>{pillarVisuals[i].icon}</span>
                  </span>
                </div>
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center gap-2">
                    <span class:list={['w-1.5 h-1.5 rounded-full', pillarVisuals[i].dot]}></span>
                    <span class:list={['font-tech-data-sm text-tech-data-sm uppercase', pillarVisuals[i].text]}>{item.tag}</span>
                  </div>
                  <h3 class="font-headline-sm text-base md:text-headline-sm text-on-surface uppercase">{item.title}</h3>
                </div>
                <p class="font-body-md text-[13px] leading-5 md:text-body-md text-on-surface-variant">{item.text}</p>
              </div>
              <div class="pt-space-md mt-space-md flex flex-wrap gap-1.5">
                {item.chips.map((chip) => <span class="font-tech-data-sm text-tech-data-sm bg-surface-container px-2 py-0.5 rounded text-outline">{chip}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ИНСТРУМЕНТЫ -->
  <section class="w-full py-6 md:py-space-2xl bg-surface relative">
    <div class={wrap}>
      <div class="flex flex-col gap-space-xs mb-space-lg">
        <span class={`${kicker} text-secondary-container`}>{a.tools.kicker}</span>
        <h2 class={h2}>{a.tools.title}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-sm">
        {
          a.tools.items.map((tool, i) => (
            <div class="p-space-md bg-surface-container-low rounded-lg hover:bg-surface-container transition-all flex items-center justify-between gap-space-sm">
              <div class="flex items-center gap-space-sm min-w-0">
                <div class:list={['w-10 h-10 shrink-0 rounded-lg bg-surface-container-high flex items-center justify-center', toolVisuals[i].cls]}>
                  <span class="material-symbols-outlined text-[22px]">{toolVisuals[i].icon}</span>
                </div>
                <div class="flex flex-col min-w-0">
                  <span class="font-headline-sm text-sm md:text-body-lg text-on-surface font-semibold">{tool.name}</span>
                  <span class="font-tech-data-sm text-tech-data-sm text-outline">{tool.desc}</span>
                </div>
              </div>
              <span class:list={['shrink-0 font-tech-data-sm text-tech-data-sm px-2 py-0.5 rounded bg-surface-container-highest', toolVisuals[i].cls]}>{tool.ver}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ОПЫТ -->
  <section class="w-full py-6 md:py-space-2xl bg-surface-container-lowest relative">
    <div class={wrap}>
      <div class="flex flex-col gap-space-xs mb-4 md:mb-space-xl">
        <span class={`${kicker} text-tertiary`}>{a.experience.kicker}</span>
        <h2 class={h2}>{a.experience.title}</h2>
      </div>
      <div class="flex flex-col gap-space-md">
        {
          a.experience.items.map((item, i) => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-space-md p-4 md:p-space-lg bg-surface-container-low rounded-xl hover:bg-surface-container transition-all">
              <div class="md:col-span-3 flex flex-col justify-start">
                <span class:list={['font-tech-data-lg text-xs md:text-tech-data-lg font-bold', expTone[i]]}>{item.period}</span>
                <span class="font-tech-data-sm text-tech-data-sm text-outline mt-1">{item.duration}</span>
              </div>
              <div class="md:col-span-9 flex flex-col gap-space-xs">
                <div class="flex flex-wrap items-center justify-between gap-space-xs">
                  <h3 class="font-headline-sm text-base md:text-headline-sm text-on-surface uppercase">{item.title}</h3>
                  <span class="font-tech-data-sm text-tech-data-sm text-on-surface-variant bg-surface-container-high px-2.5 py-1 rounded">{item.company}</span>
                </div>
                <p class="font-body-md text-[13px] leading-5 md:text-body-md text-on-surface-variant max-w-3xl">{item.text}</p>
                <div class="flex flex-wrap items-center gap-space-xs mt-2 text-outline font-tech-data-sm text-tech-data-sm">
                  <span class={expTone[i]}>▸ {item.tags[0]}</span>
                  <span>•</span>
                  <span>{item.tags[1]}</span>
                  <span>•</span>
                  <span>{item.tags[2]}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ИЗБРАННЫЕ РАБОТЫ -->
  <section class="w-full py-6 md:py-space-2xl bg-surface relative">
    <div class={wrap}>
      <div class="flex items-end justify-between gap-space-md mb-4 md:mb-space-xl">
        <div class="flex flex-col gap-space-xs">
          <span class={`${kicker} text-primary`}>{a.works.kicker}</span>
          <h2 class={h2}>{a.works.title}</h2>
        </div>
        <a href={path(lang, 'portfolio')} class="hidden sm:inline-flex items-center gap-2 font-tech-data-lg text-xs md:text-tech-data-lg text-primary hover:text-on-surface transition-colors uppercase tracking-wider">
          <span>{a.works.all}</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
        {
          a.works.items.map((work, i) => (
            <a href={path(lang, 'portfolio')} class="flex flex-col bg-surface-container-low rounded-xl overflow-hidden shadow-lg group">
              <div class="relative w-full h-64 overflow-hidden bg-surface-container-lowest">
                <img src={workVisuals[i].image} alt={work.title} loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-transparent to-transparent opacity-80"></div>
                <div class="absolute top-3 left-3 flex items-center gap-1.5 bg-surface-container-lowest/80 backdrop-blur px-2.5 py-1 rounded-full">
                  <span class:list={['w-2 h-2 rounded-full', workVisuals[i].dot]}></span>
                  <span class="font-tech-data-sm text-tech-data-sm text-on-surface">{work.badge}</span>
                </div>
                <div class:list={['absolute top-3 right-3 w-6 h-6 rounded-full shadow', workVisuals[i].swatch]}></div>
              </div>
              <div class="p-space-md flex flex-col gap-space-xs flex-grow justify-between">
                <div class="flex flex-col gap-1">
                  <span class:list={['font-tech-data-sm text-tech-data-sm uppercase', workVisuals[i].text]}>{work.tag}</span>
                  <h3 class="font-headline-sm text-sm md:text-body-lg text-on-surface font-bold uppercase tracking-tight">{work.title}</h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">{work.desc}</p>
                </div>
                <span class="mt-space-sm pt-space-xs flex items-center justify-between text-secondary-container font-tech-data-sm text-tech-data-sm uppercase tracking-wide group-hover:underline">
                  <span>{a.works.inspect}</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
      <div class="sm:hidden mt-space-md text-center">
        <a href={path(lang, 'portfolio')} class="inline-flex items-center gap-2 font-tech-data-sm text-tech-data-sm text-primary uppercase">
          <span>{a.works.allMobile}</span>
          <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ФИНАЛЬНЫЙ ПРИЗЫВ -->
  <section class="w-full py-6 md:py-space-2xl bg-surface-container-lowest relative overflow-hidden">
    <div class={`${wrap} relative z-10`}>
      <div class="flex flex-col gap-space-xs mb-4 md:mb-space-xl text-center md:text-left">
        <span class={`${kicker} text-primary`}>{a.cta.kicker}</span>
        <h2 class={h2}>{a.cta.title}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
        {
          [
            { card: a.cta.mentoring, blob: 'bg-primary-container/10', badge: 'text-secondary-container', check: 'text-primary', href: path(lang, 'mentoring'), primary: true },
            { card: a.cta.collab, blob: 'bg-secondary-container/10', badge: 'text-primary', check: 'text-secondary-container', href: path(lang, 'contacts'), primary: false },
          ].map(({ card, blob, badge, check, href, primary }) => (
            <div class="p-4 md:p-space-lg md:p-space-xl bg-surface-container-low rounded-2xl flex flex-col justify-between gap-space-lg relative overflow-hidden shadow-xl">
              <div class:list={['absolute -right-12 -top-12 w-48 h-48 rounded-full filter blur-3xl pointer-events-none', blob]}></div>
              <div class="flex flex-col gap-space-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class:list={['font-label-caps text-label-caps uppercase bg-surface-container px-2 py-0.5 rounded-full', badge]}>{card.badge}</span>
                  <span class="font-tech-data-sm text-tech-data-sm text-outline">{card.track}</span>
                </div>
                <h3 class="font-headline-md text-lg md:text-headline-md text-on-surface uppercase">{card.title}</h3>
                <p class="font-body-md text-[13px] leading-5 md:text-body-md text-on-surface-variant">{card.text}</p>
                <ul class="flex flex-col gap-2 font-tech-data-sm text-tech-data-sm text-on-surface-variant pt-space-xs">
                  {
                    card.list.map((line) => (
                      <li class="flex items-center gap-2">
                        <span class:list={['material-symbols-outlined text-[16px]', check]}>check_circle</span>
                        <span>{line}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <a
                href={primary ? `${href}#apply` : href}
                data-open-apply={primary ? '' : undefined}
                class:list={[
                  'w-full py-space-sm text-center flex items-center justify-center gap-2',
                  primary
                    ? gradientBtn
                    : 'rounded-full bg-surface-container-high text-on-surface hover:text-secondary-container hover:bg-surface-container-highest transition-all font-headline-sm text-xs md:text-tech-data-lg uppercase tracking-wider',
                ]}
              >
                <span>{card.button}</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
