---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import WorkCard from '../../components/WorkCard.astro';
import ModelCard from '../../components/ModelCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import MentoringCTA from '../../components/MentoringCTA.astro';
import { locales, t, path, type Lang } from '../../i18n';
import { SITE } from '../../config';
import { works, models, articles, toolkit } from '../../data/home';
import { mockImages } from '../../data/mockImages';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
const filters = Object.entries(dict.works.filters) as [string, string][];
const sectionClass = 'w-full max-w-[1440px] mx-auto px-4 md:px-margin-desktop py-5 md:py-space-2xl';
const stepStyles = [
  { icon: 'assignment_turned_in', glow: 'bg-primary-container', iconBg: 'from-primary-container to-inverse-primary', iconColor: 'text-on-surface', value: 'text-primary' },
  { icon: 'account_tree', glow: 'bg-secondary-container', iconBg: 'from-surface-variant to-secondary-container', iconColor: 'text-surface-container-lowest', value: 'text-secondary-container' },
  { icon: 'draw', glow: 'bg-tertiary-container', iconBg: 'from-tertiary-container to-on-tertiary', iconColor: 'text-on-surface', value: 'text-tertiary' },
];
const description = dict.hero.sub;
---

<BaseLayout lang={lang} title={`${dict.site.name} — ${dict.site.role}`} description={description} image={mockImages.heroClay}>
  <!-- HERO -->
  <section class={`relative ${sectionClass} overflow-hidden`}>
    <div class="absolute -top-32 -left-20 w-[580px] h-[580px] rounded-full bg-primary-container/10 blur-[130px] pointer-events-none"></div>
    <div class="absolute top-20 right-0 w-[640px] h-[640px] rounded-full bg-tertiary-container/15 blur-[150px] pointer-events-none"></div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-gutter-desktop items-center relative z-10">
      <div class="lg:col-span-7 max-lg:order-2 flex flex-col gap-3.5 lg:gap-space-lg">
        <div class="inline-flex items-center gap-2.5 self-start px-2.5 md:px-3.5 py-1 md:py-1.5 rounded-full bg-surface-container-high shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)]">
          <span class="w-2 h-2 shrink-0 rounded-full bg-secondary-container animate-pulse shadow-[0_0_10px_#34ff8c]"></span>
          <span class="font-tech-data-sm text-[10px] md:text-tech-data-sm text-secondary-container uppercase tracking-wider md:tracking-widest font-semibold">{dict.hero.badge}</span>
        </div>
        <h1 class="font-display-hero-mobile md:font-display-hero text-display-hero-mobile md:text-display-hero text-on-surface tracking-tight uppercase max-w-2xl">
          {dict.hero.titleBefore}
          <span class="bg-gradient-to-r from-primary via-primary-container to-tertiary-container bg-clip-text text-transparent">{dict.hero.titleAccent}</span>
        </h1>
        <p class="font-body-lg text-sm md:text-body-lg text-on-surface-variant max-w-xl leading-relaxed md:leading-normal">{dict.hero.sub}</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-2.5 md:gap-space-md pt-1 md:pt-space-xs">
          <a
            href="#mentoring-process"
            class="max-sm:w-full max-sm:justify-center min-h-[48px] px-5 md:px-8 py-3 md:py-3.5 rounded-full bg-gradient-to-r from-primary-container via-inverse-primary to-tertiary-container text-on-surface font-headline-sm text-xs md:text-tech-data-lg font-bold md:font-semibold uppercase tracking-wider shadow-[0_0_32px_-4px_rgba(160,120,255,0.45)] hover:shadow-[0_0_40px_rgba(255,87,34,0.6)] transition-all hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2"
          >
            <span>{dict.hero.apply}</span>
            <span class="material-symbols-outlined text-[18px]">north_east</span>
          </a>
          <a
            href="#selected-works"
            class="max-sm:w-full max-sm:justify-center min-h-[48px] px-5 md:px-7 py-3 md:py-3.5 rounded-full bg-surface-container-high hover:bg-surface-variant text-on-surface font-tech-data-lg text-xs md:text-tech-data-lg tracking-wide uppercase shadow-sm transition-all flex items-center gap-2"
          >
            <span>{dict.hero.work}</span>
            <span class="material-symbols-outlined text-[18px] text-secondary-container">arrow_downward</span>
          </a>
        </div>
        <div class="pt-1 md:pt-space-md flex flex-wrap items-center justify-center md:justify-start gap-x-space-lg gap-y-space-sm text-on-surface-variant font-tech-data-sm text-[10px] md:text-tech-data-sm max-md:bg-surface-container-lowest/60 max-md:py-1.5 max-md:px-2 max-md:rounded-lg">
          <div class="flex items-center gap-2"><span class="text-secondary-container font-bold">XYZ:</span><span>[0.0, 12.4, -3.2]</span></div>
          <span class="text-outline-variant">•</span>
          <div class="flex items-center gap-2"><span class="text-primary font-bold">PIPELINE:</span><span>ACEScg / Quad-Mesh</span></div>
          <span class="text-outline-variant">•</span>
          <div class="flex items-center gap-2"><span class="text-tertiary font-bold">SLOTS:</span><span>{dict.hero.slotsValue}</span></div>
        </div>
      </div>

      <!-- Split viewport: clay / wireframe -->
      <div class="lg:col-span-5 max-lg:order-1 flex flex-col">
        <div class="relative bg-surface-container-low rounded-xl overflow-hidden shadow-2xl p-2 md:p-2.5">
          <div class="flex items-center justify-between px-2.5 md:px-3 py-1.5 md:py-2 bg-surface-container-highest rounded-lg mb-2 font-tech-data-sm text-[10px] md:text-tech-data-sm">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-error-container"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-surface-bright"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
              <span class="text-on-surface font-semibold ml-2">CAM_PERSPECTIVE_01</span>
            </div>
            <div class="flex items-center gap-2 md:gap-3">
              <span class="text-on-surface-variant">50mm F/2.8</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-secondary-container font-bold">60.0 FPS</span>
            </div>
          </div>

          <div id="split-viewport" class="relative h-[280px] sm:h-[480px] rounded-lg overflow-hidden bg-surface-container-lowest touch-pan-y select-none" style="--split: 50%">
            <img src={mockImages.heroClay} alt="" fetchpriority="high" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
            <img
              src={mockImages.heroWire}
              alt=""
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover opacity-90 mix-blend-screen"
              style="clip-path: inset(0 0 0 var(--split))"
            />
            <div class="absolute inset-y-0 w-[2px] bg-gradient-to-b from-primary via-secondary-container to-tertiary-container shadow-[0_0_12px_#34ff8c]" style="left: var(--split)">
              <button
                type="button"
                id="split-handle"
                role="slider"
                aria-label="Clay / Wireframe"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                class="absolute top-1/2 -left-3.5 -translate-y-1/2 w-8 h-8 rounded-full bg-surface-container-highest shadow-xl flex items-center justify-center cursor-ew-resize focus-visible:outline focus-visible:outline-2 focus-visible:outline-secondary-container"
              >
                <span class="material-symbols-outlined text-secondary-container text-[16px]">drag_indicator</span>
              </button>
            </div>

            <div class="absolute top-2.5 left-2.5 md:top-4 md:left-4 flex flex-col gap-1.5 md:gap-2 pointer-events-none">
              <div class="px-2 md:px-3 py-0.5 md:py-1 rounded-full bg-surface-container/90 backdrop-blur-md font-tech-data-sm text-[9px] md:text-tech-data-sm text-on-surface shadow-md flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-tertiary-container"></span>
                <span>Shading: Clay / Wireframe</span>
              </div>
              <div class="px-2 md:px-3 py-0.5 md:py-1 rounded-full bg-surface-container/90 backdrop-blur-md font-tech-data-sm text-[9px] md:text-tech-data-sm text-on-surface-variant shadow-md">
                Tool: ZBrush • Blender Cycles
              </div>
            </div>
            <div class="absolute bottom-2 md:bottom-3 inset-x-2 md:inset-x-3 flex items-center justify-between px-2.5 md:px-3 py-1.5 md:py-2 rounded bg-surface-container-lowest/85 backdrop-blur-md font-tech-data-sm text-[9px] md:text-tech-data-sm text-on-surface pointer-events-none">
              <div class="flex items-center gap-4">
                <span><span class="text-outline">VERTS:</span> 48,192</span>
                <span class="hidden sm:inline"><span class="text-outline">FACES:</span> 47,820</span>
              </div>
              <div class="flex items-center gap-2 text-secondary-container">
                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                <span>100% QUADS</span>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between px-2 md:px-3 py-1 md:py-2 mt-1 md:mt-1.5 font-tech-data-sm text-[10px] md:text-tech-data-sm text-on-surface-variant">
            <span class="text-outline">GIZMO [WORLD_SPACE]</span>
            <div class="flex items-center gap-3">
              <span class="text-tertiary-container font-bold">X+</span>
              <span class="text-secondary-container font-bold">Y+</span>
              <span class="text-primary font-bold">Z+</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW MENTORING WORKS -->
  <section id="mentoring-process" class={`${sectionClass} relative`}>
    <div class="mb-4 md:mb-space-xl">
      <SectionTitle kicker={dict.process.kicker} tag={dict.process.tag} title={dict.process.title} sub={dict.process.sub} />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-gutter-desktop">
      {
        dict.process.steps.map((step, i) => (
          <div class="flex flex-col bg-surface-container rounded-xl p-4 md:p-space-lg shadow-xl hover:bg-surface-container-high transition-all duration-300 relative group overflow-hidden">
            <div class:list={['absolute top-0 right-0 w-32 h-32 rounded-full blur-2xl pointer-events-none opacity-10 group-hover:opacity-20 transition-all', stepStyles[i].glow]}></div>
            <div class="flex items-center justify-between mb-2.5 md:mb-space-md gap-space-sm">
              <div class:list={['w-10 h-10 md:w-14 md:h-14 shrink-0 rounded-full bg-gradient-to-br flex items-center justify-center shadow-lg', stepStyles[i].iconBg]}>
                <span class:list={['material-symbols-outlined text-[20px] md:text-[26px]', stepStyles[i].iconColor]}>{stepStyles[i].icon}</span>
              </div>
              <span class="font-tech-data-sm text-[10px] md:text-tech-data-sm text-secondary-container px-2 md:px-2.5 py-0.5 md:py-1 rounded bg-surface-container-lowest">{step.tag}</span>
            </div>
            <h3 class="font-headline-sm text-sm md:text-headline-sm font-bold md:font-semibold text-on-surface mb-2 md:mb-space-sm uppercase tracking-tight">{step.title}</h3>
            <p class="font-body-md text-xs md:text-body-md text-on-surface-variant mb-3 md:mb-space-lg flex-1 leading-relaxed md:leading-normal">{step.text}</p>
            <div class="bg-surface-container-low p-2 md:p-space-sm rounded-lg flex items-center justify-between gap-space-sm font-tech-data-sm text-[10px] md:text-tech-data-sm text-on-surface-variant">
              <span class="text-outline">{step.label}</span>
              <span class:list={['font-semibold text-right', stepStyles[i].value]}>{step.value}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SELECTED WORKS -->
  <section id="selected-works" class={sectionClass}>
    <div class="mb-3.5 md:mb-space-lg">
      <SectionTitle kicker={dict.works.kicker} title={dict.works.title} sub={dict.works.sub} linkLabel={dict.works.all} linkHref={path(lang, 'portfolio')} hideLinkMobile />
    </div>
    <div id="work-filters" class="flex md:flex-wrap items-center gap-2 md:gap-space-sm mb-3.5 md:mb-space-xl overflow-x-auto md:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden -mx-4 px-4 md:mx-0 md:px-0 py-1">
      {
        filters.map(([key, label], i) => (
          <button
            type="button"
            data-filter={key === 'all' ? 'all' : key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-chip whitespace-nowrap px-4 md:px-5 py-2 rounded-full font-tech-data-sm text-[11px] md:text-tech-data-sm tracking-wider uppercase transition-colors"
          >
            {label}
          </button>
        ))
      }
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 md:gap-gutter-desktop">
      {works.map((work) => <WorkCard work={work} lang={lang} />)}
    </div>
    <a href={path(lang, 'portfolio')} class="md:hidden mt-3.5 min-h-[44px] w-full py-2.5 rounded-full bg-surface-container-high text-primary font-tech-data-sm text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-1.5">
      <span>{dict.works.all}</span>
      <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
    </a>
  </section>

  <!-- MARKETPLACE -->
  <section id="marketplace" class={sectionClass}>
    <div class="mb-3.5 md:mb-space-lg p-3 md:p-space-md rounded-xl bg-surface-container-high border-l-2 md:border-l-4 border-primary flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm shadow-lg">
      <div class="flex items-center gap-space-sm">
        <span class="material-symbols-outlined text-primary text-[24px]">storefront</span>
        <div>
          <span class="font-headline-sm text-tech-data-lg text-on-surface font-bold uppercase block">{dict.marketplace.noticeTitle}</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">
            {dict.marketplace.noticeBefore} <strong class="text-on-surface">3DCult</strong>{dict.marketplace.noticeAfter}
          </span>
        </div>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-center font-tech-data-sm text-tech-data-sm text-secondary-container px-3 py-1 bg-surface-container-lowest rounded-full shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary-container animate-pulse"></span>
        <span>{dict.marketplace.live}</span>
      </div>
    </div>
    <div class="mb-3.5 md:mb-space-xl">
      <SectionTitle kicker={dict.marketplace.kicker} title={dict.marketplace.title} sub={dict.marketplace.sub} />
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 md:gap-gutter-desktop mb-3.5 md:mb-space-xl">
      {models.map((model) => <ModelCard model={model} lang={lang} />)}
    </div>
    <div class="flex justify-center">
      <a
        href={SITE.cults}
        target="_blank"
        rel="noopener noreferrer"
        class="max-md:w-full justify-center min-h-[46px] px-6 md:px-10 py-3 md:py-4 rounded-full bg-surface-container-highest hover:bg-surface-bright text-on-surface font-headline-sm text-xs md:text-tech-data-lg uppercase tracking-wider shadow-lg hover:shadow-[0_0_24px_rgba(208,188,255,0.3)] transition-all flex items-center gap-3"
      >
        <span>{dict.marketplace.open}</span>
        <span class="material-symbols-outlined text-[20px] text-primary">open_in_new</span>
      </a>
    </div>
  </section>

  <!-- BLOG -->
  <section id="blog" class={sectionClass}>
    <div class="mb-3.5 md:mb-space-xl">
      <SectionTitle kicker={dict.blog.kicker} title={dict.blog.title} sub={dict.blog.sub} linkLabel={dict.blog.all} linkHref={path(lang, 'blog')} />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-gutter-desktop">
      {articles.map((article) => <ArticleCard article={article} lang={lang} />)}
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class={sectionClass}>
    <div class="bg-surface-container rounded-2xl p-4 md:p-space-2xl shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-gutter-desktop items-center">
        <div class="lg:col-span-5 relative">
          <div class="relative bg-surface-container-low rounded-xl p-3 pt-6 shadow-xl">
            <div class="absolute top-1.5 left-3 font-tech-data-sm text-[10px] text-outline font-bold">[V_PORT: ARTIST_01]</div>
            <div class="absolute top-1.5 right-3 font-tech-data-sm text-[10px] text-secondary-container font-bold">100% ONLINE</div>
            <div class="relative h-56 md:h-96 rounded-lg overflow-hidden bg-surface-container-lowest">
              <img src={mockImages.aboutPortrait} alt={dict.site.name} loading="lazy" decoding="async" class="w-full h-full object-cover grayscale contrast-125" />
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20">
                <span class="material-symbols-outlined text-[64px] text-on-surface">filter_center_focus</span>
              </div>
              <div class="absolute bottom-3 left-3 px-3 py-1.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-md font-tech-data-sm text-tech-data-sm text-on-surface flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
                <span>{dict.about.badge}</span>
              </div>
            </div>
            <div class="flex items-center justify-between mt-2 pt-1 font-tech-data-sm text-tech-data-sm text-on-surface-variant">
              <span>LOC: STUDIO WORKSTATION</span>
              <span class="text-primary font-bold">CORE PIPELINE V4.2</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 flex flex-col gap-2.5 md:gap-space-md">
          <div class="inline-flex items-center gap-2 font-tech-data-sm text-tech-data-sm text-primary tracking-widest uppercase">
            <span>{dict.about.kicker}</span>
          </div>
          <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight uppercase">{dict.about.title}</h2>
          <div class="flex flex-col gap-space-sm text-on-surface-variant font-body-md text-xs md:text-body-md leading-relaxed md:leading-normal">
            <p>{dict.about.p1}</p>
            <p>{dict.about.p2}</p>
          </div>
          <div class="pt-space-xs">
            <span class="font-tech-data-sm text-tech-data-sm text-outline uppercase tracking-wider block mb-2">{dict.about.toolkit}</span>
            <div class="flex flex-wrap gap-2">
              {
                toolkit.map((tool) => (
                  <span class="px-2.5 md:px-3.5 py-1 md:py-1.5 rounded-full bg-surface-container-high text-on-surface font-tech-data-sm text-[10px] md:text-tech-data-sm flex items-center gap-2">
                    <span class:list={['w-1.5 h-1.5 rounded-full', tool.dot]} />
                    {tool.name}
                  </span>
                ))
              }
            </div>
          </div>
          <div class="pt-space-sm">
            <a
              href={path(lang, 'about')}
              class="inline-flex items-center gap-1.5 md:gap-2 font-tech-data-lg text-xs md:text-tech-data-lg text-primary hover:text-on-surface transition-colors uppercase tracking-wider group"
            >
              <span>{dict.about.more}</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <MentoringCTA lang={lang} />
</BaseLayout>

<script>
  // Фильтр работ по категории
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('[data-work]');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => card.classList.toggle('hidden', filter !== 'all' && card.dataset.category !== filter));
    }),
  );

  // Разделитель «глина / сетка» в hero
  const viewport = document.getElementById('split-viewport');
  const handle = document.getElementById('split-handle');
  if (viewport && handle) {
    const set = (percent: number) => {
      const value = Math.min(100, Math.max(0, percent));
      viewport.style.setProperty('--split', `${value}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(value)));
    };
    const fromEvent = (e: PointerEvent) => {
      const rect = viewport.getBoundingClientRect();
      set(((e.clientX - rect.left) / rect.width) * 100);
    };
    handle.addEventListener('pointerdown', (e) => {
      handle.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    handle.addEventListener('pointermove', (e) => {
      if (handle.hasPointerCapture(e.pointerId)) fromEvent(e);
    });
    handle.addEventListener('keydown', (e) => {
      const current = Number(handle.getAttribute('aria-valuenow'));
      if (e.key === 'ArrowLeft') set(current - 5);
      if (e.key === 'ArrowRight') set(current + 5);
    });
  }
</script>
