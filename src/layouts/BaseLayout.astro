---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';
import FavoritesPanel from '../components/FavoritesPanel.astro';
import { htmlLang, locales, type Lang } from '../i18n';
import { SITE } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Путь страницы без языка ("" для главной) */
  page?: string;
  image?: string;
}

const { lang, title, description, page = '', image } = Astro.props;
const urlFor = (code: string) => new URL(`/${code}/${page}`, SITE.url).href;
---

<!doctype html>
<html lang={htmlLang[lang]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlFor(lang)} />
    {locales.map((code) => <link rel="alternate" hreflang={htmlLang[code]} href={urlFor(code)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor('ru')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    {image && <meta property="og:image" content={image} />}
    <meta name="theme-color" content="#131317" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
  </head>
  <body class="bg-background text-on-surface font-body-md text-body-md antialiased selection:bg-primary-container selection:text-on-primary-container">
    <Header lang={lang} page={page} />
    <main class="w-full pt-14 lg:pt-20 bg-background min-h-screen">
      <slot />
    </main>
    <Footer lang={lang} />
    <AuthModal lang={lang} />
    <FavoritesPanel lang={lang} />
  </body>
</html>
